# Copy the values you need into .env.local (Next.js vars) and/or .env
# (Python function vars, read by api/_lib/ai_core.py). Both are gitignored.

# ── Next.js (NEXT_PUBLIC_* is exposed to the browser) ──────────────────────
NEXT_PUBLIC_API_URL=https://eventhub-backend-api.runasp.net/api
# Only needed for local dev if running the AI function as a standalone
# `uvicorn api.ai.chat:app --port 8001` process instead of `vercel dev`.
# Leave unset in production — the Python function is same-origin there.
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8001

# ── AI Planner Python function (api/ai/chat.py, api/_lib/ai_core.py) ───────
# In production these live in Vercel → Project Settings → Environment
# Variables, not in a committed file.

# Get a key at https://openrouter.ai/keys. The key that shipped in the
# original hand-off script was pasted in plain text and sent over WhatsApp
# — it was rotated; never commit a real key here.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional — defaults to qwen/qwen3-235b-a22b-2507 if unset.
MODEL_NAME=qwen/qwen3-235b-a22b-2507

# Root of the EventHub .NET backend (no trailing /api).
BACKEND_BASE_URL=https://eventhub-backend-api.runasp.net
